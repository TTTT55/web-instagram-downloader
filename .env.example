# ---- Public (exposed to the browser) ----
# Canonical site URL used for SEO metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://quickvideosaver.me
# Contact / DMCA email shown on legal pages
NEXT_PUBLIC_CONTACT_EMAIL=support@quickvideosaver.me
# Leave empty when the API runs on the same origin (Next.js route handlers).
# Set to your Cloudflare Worker / Deno Deploy URL when the frontend is hosted statically.
NEXT_PUBLIC_API_BASE=
# Google AdSense publisher id (ca-pub-xxxxxxxx). Empty = show placeholder slots.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---- Server only ----
# Instagram GraphQL doc_ids to try, comma separated (update if Instagram rotates them)
IG_DOC_IDS=27128499623469141,8845758582119845,10015901848480474
# Best-effort per-IP rate limit for /api/download
RATE_LIMIT_PER_MINUTE=30
# Optional webhook (Discord / Slack / Formspree / Make) that receives contact-form messages.
CONTACT_WEBHOOK_URL=
